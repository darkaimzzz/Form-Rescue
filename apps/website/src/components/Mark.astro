---
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false" class="mark">
  <rect width="64" height="64" rx="16" fill="var(--fr-accent)"></rect>
  <g fill="none" stroke="var(--fr-on-accent)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M16 18h32M16 28h18"></path>
    <path d="M47 28v8a6 6 0 0 1-6 6H18"></path>
    <path d="M25 35l-7 7 7 7"></path>
  </g>
</svg>
