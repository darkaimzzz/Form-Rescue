---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist.">
  <section class="section center">
    <div class="wrap">
      <h1 class="display">Page not found</h1>
      <p class="lead">This page doesn't exist. Check the address, or use the links below.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">Go to the homepage</a>
        <a class="btn" href="/docs/">Read the docs</a>
      </div>
    </div>
  </section>
</Base>
