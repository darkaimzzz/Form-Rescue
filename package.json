{
  "name": "form-rescue",
  "private": true,
  "version": "0.1.0",
  "description": "Recover saved form drafts on the sites you choose. Local to your browser. Open source.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:extension:chrome": "pnpm --filter @form-rescue/extension dev:chrome",
    "dev:extension:firefox": "pnpm --filter @form-rescue/extension dev:firefox",
    "dev:website": "pnpm --filter @form-rescue/website dev",
    "lint": "eslint . && pnpm --filter @form-rescue/extension lint:firefox",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @form-rescue/website check",
    "test": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e:chrome": "pnpm --filter @form-rescue/extension build:e2e && playwright test --project=e2e",
    "test:a11y": "pnpm build && playwright test --project=a11y",
    "test:performance": "pnpm --filter @form-rescue/extension build:e2e && playwright test --project=performance && node scripts/validate-release/website-budget.mjs",
    "build": "pnpm --filter @form-rescue/extension build && pnpm --filter @form-rescue/website build",
    "package": "node scripts/package-release/package.mjs",
    "release:validate": "node scripts/validate-release/validate.mjs",
    "fixtures": "node tests/fixtures/generate.mjs && node tests/fixtures/server.mjs",
    "test:firefox": "node tests/fixtures/generate.mjs && pnpm --filter @form-rescue/extension build:e2e:firefox && node tests/firefox/bidi-smoke.mjs",
    "assets:capture": "node tests/fixtures/generate.mjs && pnpm --filter @form-rescue/extension build:e2e && node scripts/assets/capture.mjs",
    "assets:brand": "node scripts/assets/render-brand.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@form-rescue/core": "workspace:*",
    "@form-rescue/storage": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.0",
    "@types/node": "24.13.6",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "idb": "8.0.3",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue": "3.5.43",
    "zod": "4.6.5"
  }
}
